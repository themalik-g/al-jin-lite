# .env — Al-Jin Lite local settings (lines starting with # are comments)
#
# Your own WhatsApp number (country code + number, digits only), e.g. 923001234567.
# Leave it empty to be asked in the terminal when you first start the bot.
WRAITH_PHONE=
WRAITH_BRANCH=main
UV_THREADPOOL_SIZE=2

# How long the terminal waits for you to type a number before falling back to
# WRAITH_PHONE (milliseconds). Only used when WRAITH_PHONE is filled in.
WRAITH_PROMPT_TIMEOUT_MS=20000

# ── RAM budget (small-VPS tuning) ──
# Total RAM in MB that index.js may use across the orchestrator + every
# WhatsApp session it spawns. Each session's --max-old-space-size is this
# number divided by however many sessions are currently running. Lower this
# if your box has less than 256MB; raise it if you have more.
WRAITH_RAM_BUDGET_MB=220
# Force one exact per-session heap size (MB) instead of auto-splitting the
# budget above. Leave unset unless you know you want a fixed value.
# WRAITH_MAX_OLD_SPACE_SIZE=96
# V8 young-generation size (MB); 8 is a sane floor on a 256MB box.
# WRAITH_V8_SEMI_SPACE_SIZE=8

# In-RAM "waiting for this message" cache (start.js). Smaller = less RAM,
# shorter retry window. Defaults shown are already lite-sized.
# WRAITH_MSG_STORE_MAX=400
# WRAITH_MSG_STORE_TTL_H=2

# Verbose Baileys logs (decrypt errors, bad MAC, etc.) — leave unset/silent
# normally; set to warn/error/info/debug only while diagnosing a problem.
# WRAITH_LOG_LEVEL=silent
# WRAITH_DEBUG=

# ── Downloads / disk (optional — normally set live with .dlcap / .disk) ──
# Maximum size of one download in MB. Can also be changed live with .dlcap 300mb
# WRAITH_MAX_DOWNLOAD_MB=300
# AIJIN_DISK_RESERVE_MB=100

# ── Owner / developer access ──
# Off by default. Only set this on YOUR OWN deployments if you want that number
# to always count as an owner of this bot.
# WRAITH_DEV_ACCESS=

# ── Resource limits (optional — normally set live with .cpulimit / .ramlimit) ──
# CPU cap in cores ("0.30"), as a percentage ("30%") or "auto" (90% of the
# server's CPU quota, if the host exposes one via cgroups).
# AL_JIN_CPU_LIMIT=0.30
# RAM ceiling in MB for the governor's own watch (separate from the Node heap
# flags above). Add AL_JIN_RAM_RESTART=1 to restart if it stays over for 20s.
# AL_JIN_RAM_LIMIT_MB=200
# AL_JIN_RAM_RESTART=0

# ── Poll reply mode / menu (optional) ──
# How long a poll stays usable before it is deleted (ms).
# AL_JIN_POLL_TTL_MS=60000
# Verified JID used for the menu's blue-tick status quote.
# WRAITH_FAKE_QUOTE_JID=

# ── Gemini (optional, only if you use .jinai / Gemini-backed commands) ──
# GEMINI_API_KEY=

# ── Multi-session (optional) ──
# Delay between starting sessions at boot (ms). 0 = start all at once.
# WRAITH_SPAWN_STAGGER_MS=2500
# Shared data folder for all sessions (default: instances/_shared). Set by the launcher.
# WRAITH_SHARED_DIR=

# ── Session ID (optional) — skip pairing completely ──
# Get it from your Jin pairing site. When SESSION_ID is set the bot connects with it instead of
# asking for a number / pairing code. SESSION_API is the address of your session store (Cloudflare Worker).
SESSION_ID=
SESSION_API=
# SESSION_SYNC=off   # never upload refreshed login data back to the store
